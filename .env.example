# Vzor konfigurace. Zkopírujte na `.env` a doplňte vlastní hodnoty.
# `.env` do gitu nepatří (je v .gitignore).

# --- Django ---
# Vygenerujte vlastní, např.:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# --- Databáze (PostgreSQL) ---
# Aplikace běží nad PostgreSQL i při vývoji a při testech. Databázi nahodíte
# příkazem `docker compose up -d db`; port ven nevede, jede jen uvnitř compose.
POSTGRES_DB=spiz
POSTGRES_USER=spiz
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- První superuživatel (vytvoří se při startu kontejneru) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# --- HTTPS ---
# Zapněte až ve chvíli, kdy aplikace jede za HTTPS. Na HTTP instalaci by
# se nikdo nepřihlásil (bezpečné cookie prohlížeč nepošle) a přesměrování
# na HTTPS by se zacyklilo. Reverzní proxy musí posílat X-Forwarded-Proto.
HTTPS_ONLY=False

# --- Zálohy ---
# Stažení dumpu celé databáze z /backup/. Dump obsahuje hashe hesel a data
# všech jídelen; nastavte na False, chcete-li přístup zavřít bez nové verze.
DB_DUMP_DOWNLOAD_ENABLED=True

# --- OCR ---
# Klíč k Mistral OCR pro načítání příjemek z fotky.
# Vlastní klíč získáte na console.mistral.ai.
MISTRAL_API_KEY=

# Jak dlouho se drží nahraný sken dokladu, který nikdo nedopracoval (dny).
OCR_SCAN_RETENTION_DAYS=7
