@startuml Canteen_Component
!theme plain
skinparam componentStyle rectangle

title Canteen Project - Component Architecture

actor "Canteen Manager" as Manager
actor "Chef / Kitchen Staff" as Chef
database "Database (SQLite3)" as DB

package "Web Infrastructure" {
    [Web Browser] as Browser
    [Django Application] as DjangoApp
}

package "Django Apps" {
    [warehouse] as Warehouse
    [recipes] as Recipes
    [dispatch] as Dispatch
    [orders] as Orders
    [reports] as Reports
}

' User Interactions
Manager --> Browser
Chef --> Browser
Browser --> DjangoApp

' App Interactions
Dispatch ..> Warehouse : "Updates stock"
Dispatch ..> Recipes : "Needs recipe data"

Orders ..> Recipes : "Needs recipe data"
Orders ..> Warehouse : "Checks stock levels"

Reports ..> Warehouse : "Reads stock/value"
Reports ..> Recipes : "Reads ingredient costs"
Reports ..> Orders : "Reads planning data"
Reports ..> Dispatch : "Reads usage data"

' Database Connection
DjangoApp --> DB

@enduml
